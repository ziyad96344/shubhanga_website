# Used only when the (sub)domain points at this project folder instead of
# public/. Sends every request into public/, so .env, vendor/, storage/ and
# the source code are never served directly.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

# Fallback if mod_rewrite is missing: refuse dotfiles such as .env
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
